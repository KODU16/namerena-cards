+    pub fn encounter_snapshot(&self) -> CliApiResult<String> {
+        let rows: Vec<_> = self
+            .driver
+            .runner
+            .runtime()
+            .entities
+            .iter()
+            .filter(|(id, e)| *id == e.runtime.root_owner)
+            .map(|(id, e)| {
+                // 输入阵营参与身份匹配，敌我同名不能相互继承血量或状态。
+                let group = self.driver.runner.input_groups.iter().position(|g| g.contains(&id)).unwrap_or(usize::MAX);
+                (e.template.id_key_name.clone(), e.runtime.clone(), e.states.clone(), group)
+            })
+            .collect();
+        serde_json::to_string(&rows).map_err(|e| crate::cli_api::CliApiError::InvalidArgument(e.to_string()))
+    }
