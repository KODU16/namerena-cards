+    /// 读档恢复仅匹配同名原始角色；新换入角色沿用自己的开局值。
+    pub fn restore_encounter(&mut self, json: &str) -> CliApiResult<()> {
+        use crate::runtime::{PlayerRuntime, StateStore, WorldArena};
+        type Row = (String, PlayerRuntime, StateStore, usize);
+        if self.driver.rounds_advanced != 0 || self.paused.is_some() {
+            return Err(crate::cli_api::CliApiError::InvalidArgument(
+                "encounter restore requires a new session".into(),
+            ));
+        }
+        let rows: Vec<Row> =
+            serde_json::from_str(json).map_err(|e| crate::cli_api::CliApiError::InvalidArgument(e.to_string()))?;
+        let input_groups = self.driver.runner.input_groups.clone();
+        let runtime = self.driver.runner.runtime_mut();
+        let ids: Vec<_> = runtime.entities.iter().map(|(id, _)| id).collect();
+        for id in ids {
+            let entity = runtime.entities.get_mut(id).unwrap();
+            let group = input_groups.iter().position(|g| g.contains(&id)).unwrap_or(usize::MAX);
+            if let Some((_, saved, states, _)) = rows
+                .iter()
+                .find(|(name, _, _, side)| *name == entity.template.id_key_name && *side == group)
+            {
+                entity.runtime = saved.clone();
+                entity.runtime.owner = id;
+                entity.runtime.root_owner = id;
+                entity.runtime.team = entity.template.team;
+                entity.runtime.move_state = entity.template.move_state;
+                entity.states = states.clone();
+                // 保留存档生命和负面状态，同时使用当前装备与成长后的模板属性。
+                crate::runtime::forced_action::with_state(&mut self.driver.forced, || {
+                    entity.refresh_runtime_stats_from_template();
+                });
+            }
+        }
