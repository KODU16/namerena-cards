+use super::*;
+impl CombatRuntime {
+    // 仅在负面状态实际落地后调用；狂暴、净化及失败的命中不会进入此入口。
+    pub(crate) fn language_debuff(&mut self, caster: EntityIdx, target: EntityIdx) {
+        let Some(team) = self.language_relic_team else {
+            return;
+        };
+        let Some(from) = self.entities.get(caster) else {
+            return;
+        };
+        let root = self.entities.get(from.runtime.root_owner).unwrap_or(from);
+        if root.template.team != team || from.runtime.team != team {
+            return;
+        }
+        let Some(to) = self.entities.get_mut(target) else {
+            return;
+        };
+        if to.template.team == team || !to.runtime.alive || to.runtime.hp <= 0 {
+            return;
+        }
+        let step = to
+            .states
+            .entry(PLAIN_BERSERK_STATE_KEY)
+            .and_then(|entry| match entry.payload {
+                StatePayload::Berserk { step } => Some(step),
+                _ => None,
+            })
+            .unwrap_or(0)
+            .max(1);
+        if !to.states.set_payload(PLAIN_BERSERK_STATE_KEY, StatePayload::Berserk { step }) {
+            to.states.add_entry(StateEntry::berserk(PLAIN_BERSERK_STATE_KEY, step));
+        }
+    }
+
+    // 卡牌玩家及其派生单位即使经吞噬提高原始幻术，也只按 5 计算；普通引擎对局不变。
+    pub(crate) fn card_skill_level(&self, actor: EntityIdx, skill: BuiltinActiveSkill, level: u32) -> u32 {
+        let root = self.entities.get(actor).and_then(|entity| self.entities.get(entity.runtime.root_owner));
+        if skill == BuiltinActiveSkill::Shadow
+            && root.is_some_and(|entity| crate::runtime::forced_action::controlled_team() == Some(entity.template.team))
+        {
+            level.min(5)
+        } else {
+            level
+        }
+    }
+    // 根角色的原始队伍决定能力归属，敌方与被魅惑角色不会借用玩家能力。
+    pub(crate) fn ability_value(&self, actor: EntityIdx, skill: &str) -> (u32, f64) {
+        let Some(entity) = self.entities.get(actor) else {
+            return (0, 1.0);
+        };
+        let root = self.entities.get(entity.runtime.root_owner).unwrap_or(entity);
+        crate::runtime::forced_action::ability_value(root.template.team, skill)
+    }
+    pub(crate) fn ability_scope(&self, actor: EntityIdx, skill: &str) -> crate::runtime::forced_action::AbilityScope {
+        let (cost, power) = self.ability_value(actor, skill);
+        let root = self.entities.get(actor).map_or(actor, |e| e.runtime.root_owner);
+        crate::runtime::forced_action::scope_ability(root.0, power, cost)
+    }
+}
