+            assert_eq!(buff.entities.get(spawned).unwrap().runtime.defense, after[1]);
+            assert_eq!(buff.entities.get(spawned).unwrap().runtime.resistance, after[5]);
+        }
+        assert!(seen.iter().all(|n| *n));
+    }
