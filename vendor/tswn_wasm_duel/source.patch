+                || entity.runtime.owner != entity.runtime.root_owner
+            {
+                return Err(CliApiError::InvalidArgument("invalid initial HP".into()));
+            }
+        }
+        for pair in packet.chunks_exact(2) {
+            self.driver
+                .runner
+                .runtime_mut()
