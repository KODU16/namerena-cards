+                    && self
+                        .driver
+                        .runner
+                        .runtime()
+                        .registry
+                        .player_kind(entity.runtime.kind)
+                        .is_some_and(|kind| kind.export_name == crate::runtime::profile::DEFAULT_CORE_CLONE_KIND_EXPORT)
+            })
+            .map(|(id, entity)| {
+                (
+                    id,
+                    entity.runtime.root_owner,
